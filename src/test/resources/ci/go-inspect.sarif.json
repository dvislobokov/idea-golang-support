{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Go Project Support",
          "version": "0.2.51",
          "semanticVersion": "0.2.51",
          "rules": [
            {
              "id": "GoModVersions",
              "name": "GoModVersions",
              "shortDescription": {
                "text": "Go and toolchain versions"
              },
              "fullDescription": {
                "text": "Go and toolchain versions"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "Go modules"
                ]
              }
            },
            {
              "id": "GoTypeMismatch",
              "name": "GoTypeMismatch",
              "shortDescription": {
                "text": "Type mismatch"
              },
              "fullDescription": {
                "text": "Reports values of a type that does not fit."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "Go"
                ]
              }
            },
            {
              "id": "GoUnusedVariable",
              "name": "GoUnusedVariable",
              "shortDescription": {
                "text": "Unused variable"
              },
              "fullDescription": {
                "text": "Reports variables that are declared but never used."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "Go"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "file:///C:/work/app/"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "GoNilDereference on main.go: IllegalStateException: boom"
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "results": [
        {
          "ruleId": "GoUnusedVariable",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "Unused variable 'y' <-chan"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 2,
                  "endLine": 3,
                  "endColumn": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "GoTypeMismatch",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Cannot use \"s\" (untyped string) as int"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 10,
                  "endLine": 7,
                  "endColumn": 13
                }
              }
            }
          ]
        },
        {
          "ruleId": "GoUnusedVariable",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "Unused variable 'x'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pkg/a%20b.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 2,
                  "endLine": 4,
                  "endColumn": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
