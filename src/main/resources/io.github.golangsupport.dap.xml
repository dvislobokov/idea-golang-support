<!-- A content module of the plugin: everything that needs the DAP module of the platform (2026.1+, not in every IDE) lives here,
     so where that module is absent only this part is switched off and the rest of the plugin loads. Classes: io.github.golangsupport.dap. -->
<idea-plugin package="io.github.golangsupport.dap">
    <dependencies>
        <module name="intellij.platform.dap"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <platform.dap.launchArgumentsProvider implementation="io.github.golangsupport.dap.GoDapLaunchArgumentsProvider"/>
        <platform.dap.debugAdapterSupportProvider implementation="io.github.golangsupport.dap.GoDebugAdapterSupportProvider"/>
        <!-- breakpoints in .go make sense only with the debugger, so their types are a part of this module -->
        <xdebugger.breakpointType implementation="io.github.golangsupport.dap.GoLineBreakpointType"/>
        <xdebugger.breakpointType implementation="io.github.golangsupport.dap.GoPanicBreakpointType"/>
    </extensions>

    <actions>
        <group id="Go.Debugger" text="Debugger" popup="true" icon="AllIcons.Actions.StartDebugger">
            <action id="Go.Debugger.ShowLogs" class="io.github.golangsupport.dap.ShowDebuggerLogsAction" text="Show Debugger Logs"
                    description="Open the directory with the logs of delve and the traces of the protocol"/>
            <action id="Go.Debugger.TraceProtocol" class="io.github.golangsupport.dap.TraceDebuggerProtocolAction" text="Trace Debugger Protocol"
                    description="Write every DAP message of the debug sessions that start from now on next to the debugger logs"/>
            <add-to-group group-id="Go.MainMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
