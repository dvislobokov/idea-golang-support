<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>io.github.golangsupport</id>
    <name>Go Project Support</name>
    <vendor>dvislobokov</vendor>

    <description><![CDATA[
        Go support for IntelliJ-based IDEs that have none, built on the tools of the Go ecosystem:
        <ul>
            <li><b>gopls</b> for errors, completion, navigation and refactorings (the LSP client of the platform)</li>
            <li><b>delve</b> behind the Debug button (the DAP client of the platform)</li>
            <li>the <b>go</b> command: build, vet, run, test with a test tree, modules and their dependencies</li>
            <li>gofmt / goimports behind Reformat Code</li>
            <li>syntax highlighting, Structure view, folding, Go to Symbol that work without any tool</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- GoLand, or the JetBrains Go plugin in IntelliJ IDEA: the same file type, and nothing this plugin could add -->
    <incompatible-with>org.jetbrains.plugins.go</incompatible-with>

    <!-- optional parts: a module is loaded only where its dependencies are (see the descriptor of the module next to META-INF) -->
    <content>
        <module name="io.github.golangsupport.lsp"/>
    </content>

    <!-- the native Go PSI (go-psi-core, go-psi-semantic; docs/psi/, MIGRATION.md): stub and file indices, project model and semantic services.
         Not the parser (go-psi-core-language.xml, step 4), not the library roots (go-psi-semantic-roots.xml, step 7), not the IDE features
         (go-psi-ide-*.xml, one per feature at step 8) -->
    <xi:include href="/META-INF/go-psi-core.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/go-psi-semantic.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <!-- the parser, PSI and lexer of go-psi-core (MIGRATION.md step 4); the stub indices of go-psi-core.xml fill up from here on -->
    <xi:include href="/META-INF/go-psi-core-language.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <!-- editor features over that PSI: structure, breadcrumbs, folding, Go to Class / Symbol, commenter, braces, quotes, find-usages words -->
    <xi:include href="/META-INF/go-psi-ide-editor.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensionPoints>
        <!-- restarts the language server when its settings change: the module with gopls, where it is loaded -->
        <extensionPoint qualifiedName="io.github.golangsupport.languageServerControl" interface="io.github.golangsupport.settings.GoLanguageServerControl" dynamic="true"/>
        <!-- what a function returns: asked by the fixes of the linter, answered by the module with gopls -->
        <extensionPoint qualifiedName="io.github.golangsupport.signatureProvider" interface="io.github.golangsupport.lint.GoSignatureProvider" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Go" implementationClass="io.github.golangsupport.lang.GoFileType" fieldName="INSTANCE" language="Go" extensions="go"/>
        <fileType name="Go Module" implementationClass="io.github.golangsupport.mod.GoModFileType" fieldName="INSTANCE" language="GoModule"
                  fileNames="go.mod;go.work"/>
        <fileIconProvider implementation="io.github.golangsupport.view.GoFileIconProvider"/>
        <!-- *_test.go are tests: the "Tests" scope of the platform, and with it the green background in the tree and the tabs -->
        <testSourcesFilter implementation="io.github.golangsupport.testing.GoTestSourcesFilter"/>

        <lang.syntaxHighlighterFactory language="Go" implementationClass="io.github.golangsupport.lang.GoSyntaxHighlighterFactory"/>
        <annotator language="Go" implementationClass="io.github.golangsupport.lang.GoIdentifierAnnotator"/>
        <!-- on the declarations GoDeclarations finds by tokens -->
        <testFinder implementation="io.github.golangsupport.lang.GoTestFinder"/>
        <testCreator language="Go" implementationClass="io.github.golangsupport.lang.GoTestCreator"/>
        <fileBasedIndex implementation="io.github.golangsupport.lang.GoDeclarationIndex"/>
        <!-- what every file of the project exports: the packages of the project in the catalogue of completion -->
        <fileBasedIndex implementation="io.github.golangsupport.catalogue.GoExportsIndex"/>
        <!-- indentation while typing, the way gofmt would have it; whole files are formatted by gofmt itself -->
        <lineIndentProvider implementation="io.github.golangsupport.lang.GoLineIndentProvider"/>
        <enterHandlerDelegate order="first" implementation="io.github.golangsupport.lang.GoEnterBetweenBracketsHandler"/>
        <langCodeStyleSettingsProvider implementation="io.github.golangsupport.lang.GoCodeStyleSettingsProvider"/>
        <!-- `if err != nil` and the `defer` that belongs to the line above, as grey text: rules, not a model -->
        <inline.completion.provider implementation="io.github.golangsupport.lang.GoInlineIdiomsProvider"/>
        <!-- the colours of Go in GoLand, where they differ from the defaults the keys inherit -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/GoDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/GoDarcula.xml"/>
        <colorSettingsPage implementation="io.github.golangsupport.lang.GoColorSettingsPage"/>
        <defaultLiveTemplates file="/liveTemplates/Go.xml"/>
        <completion.contributor language="Go" order="first" implementationClass="io.github.golangsupport.lang.GoStructTagCompletionContributor"/>
        <!-- functions and types of the standard library and of the modules of go.mod by their own names: `Printl` is `fmt.Println` -->
        <completion.contributor language="Go" implementationClass="io.github.golangsupport.catalogue.GoCatalogueCompletionContributor"/>
        <postStartupActivity implementation="io.github.golangsupport.catalogue.GoCatalogueStartupActivity"/>
        <!-- the interfaces of the project are read once the index is there: Implement Interface opens at once -->
        <postStartupActivity implementation="io.github.golangsupport.lang.GoProjectInterfacesStartup"/>
        <!-- the page about the plugin, once after the installation and after every update -->
        <postStartupActivity implementation="io.github.golangsupport.help.GoWelcomePageActivity"/>
        <!-- `nil, err` after `return`: the values of the function as one item -->
        <completion.contributor language="Go" order="first" implementationClass="io.github.golangsupport.lang.GoReturnCompletionContributor"/>
        <!-- `type Name struct {...}`, `for i, x := range xs`: what a keyword can begin here, expanded as live templates -->
        <completion.contributor language="Go" order="first" implementationClass="io.github.golangsupport.lang.GoKeywordCompletionContributor"/>
        <!-- `404` → `http.StatusNotFound`; the layouts of time.Parse / Format inside the string -->
        <completion.contributor language="Go" order="first" implementationClass="io.github.golangsupport.lang.GoValueCompletionContributor"/>
        <codeInsight.template.postfixTemplateProvider language="Go" implementationClass="io.github.golangsupport.lang.GoPostfixTemplateProvider"/>
        <codeInsight.implementMethod language="Go" implementationClass="io.github.golangsupport.lang.GoImplementMethodsHandler"/>
        <lang.smartEnterProcessor language="Go" implementationClass="io.github.golangsupport.lang.GoSmartEnterProcessor"/>
        <!-- Ctrl+Alt+T: the selected lines into if / for / func() {}() by the text -->
        <lang.surroundDescriptor language="Go" implementationClass="io.github.golangsupport.lang.GoSurroundDescriptor"/>
        <typedHandler implementation="io.github.golangsupport.lang.GoDocCommentTypedHandler"/>
        <!-- a Cyrillic letter typed in code is a key of the Russian layout left on: the handlers of the platform are given its Latin
             character. The last of the handlers of the editor is the one around the others, the completion list among them -->
        <editorTypedHandler implementationClass="io.github.golangsupport.lang.GoLayoutTypedHandler" id="Go.Layout" order="last"/>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoHandleErrorIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoCheckErrorIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoAddMissingReturnIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoCreateFunctionIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoAddStructTagsIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoReorderFieldsIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoImplementInterfaceIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <language>Go</language>
            <className>io.github.golangsupport.lang.GoGenerateTestIntention</className>
            <category>Go</category>
        </intentionAction>
        <liveTemplateContext contextId="GO" implementation="io.github.golangsupport.lang.GoTemplateContext"/>
        <liveTemplateMacro implementation="io.github.golangsupport.lang.GoTypeNameMacro"/>
        <liveTemplateMacro implementation="io.github.golangsupport.lang.GoErrorReturnMacro"/>

        <lang.parserDefinition language="GoModule" implementationClass="io.github.golangsupport.mod.GoModParserDefinition"/>
        <lang.syntaxHighlighterFactory language="GoModule" implementationClass="io.github.golangsupport.mod.GoModSyntaxHighlighterFactory"/>
        <lang.commenter language="GoModule" implementationClass="io.github.golangsupport.mod.GoModCommenter"/>
        <lang.foldingBuilder language="GoModule" implementationClass="io.github.golangsupport.mod.GoModFoldingBuilder"/>
        <!-- directives, the module paths of the cache, versions from the cache and the proxy -->
        <completion.contributor language="GoModule" implementationClass="io.github.golangsupport.mod.GoModCompletionContributor"/>
        <!-- the requirements of a module with their updates and vulnerabilities -->
        <toolWindow id="Go Dependencies" anchor="bottom" icon="/icons/goDependenciesToolWindow.svg" factoryClass="io.github.golangsupport.mod.GoDependenciesToolWindowFactory" doNotActivateOnStart="true"/>
        <!-- go.mod saved with other requirements than before: the banner with `go mod tidy` -->
        <editorNotificationProvider implementation="io.github.golangsupport.mod.GoModNotificationProvider"/>

        <treeStructureProvider implementation="io.github.golangsupport.view.GoDependenciesTreeProvider"/>
        <notificationGroup id="Go" displayType="BALLOON"/>
        <projectConfigurable parentId="tools" id="io.github.golangsupport.settings" displayName="Go"
                             instance="io.github.golangsupport.settings.GoSettingsConfigurable"/>
        <!-- every setting of the installed gopls, from `gopls api-json` -->
        <projectConfigurable parentId="io.github.golangsupport.settings" id="io.github.golangsupport.settings.languageServer" displayName="Language Server"
                             instance="io.github.golangsupport.settings.GoLanguageServerConfigurable"/>
        <projectConfigurable parentId="io.github.golangsupport.settings.languageServer" id="io.github.golangsupport.settings.gopls" displayName="gopls"
                             instance="io.github.golangsupport.settings.GoplsSettingsConfigurable"/>
        <projectConfigurable parentId="io.github.golangsupport.settings" id="io.github.golangsupport.settings.debugger" displayName="Debugger"
                             instance="io.github.golangsupport.settings.GoDebuggerConfigurable"/>
        <projectConfigurable parentId="io.github.golangsupport.settings" id="io.github.golangsupport.settings.editor" displayName="Editor and Completion"
                             instance="io.github.golangsupport.settings.GoEditorConfigurable"/>
        <projectConfigurable parentId="io.github.golangsupport.settings" id="io.github.golangsupport.settings.codeQuality" displayName="Code Quality"
                             instance="io.github.golangsupport.settings.GoCodeQualityConfigurable"/>

        <iconMapper mappingFile="GoIconMappings.json"/>
        <!-- the debugger: the plugin's own DAP client to `dlv dap` on the XDebugger API, which every IDE has (the DAP module of the platform,
             2026.1+, is absent from a number of IDEs and forks) -->
        <programRunner implementation="io.github.golangsupport.debugger.GoDebugRunner"/>
        <xdebugger.breakpointType implementation="io.github.golangsupport.debugger.GoLineBreakpointType"/>
        <xdebugger.breakpointType implementation="io.github.golangsupport.debugger.GoPanicBreakpointType"/>
        <xdebugger.breakpointType implementation="io.github.golangsupport.debugger.GoFunctionBreakpointType"/>
        <xdebugger.attachDebuggerProvider implementation="io.github.golangsupport.debugger.GoAttachDebuggerProvider"/>
        <completion.contributor language="Go" order="first" implementationClass="io.github.golangsupport.debugger.GoExpressionCompletionContributor"/>
        <registryKey key="go.debugger.protocol.trace" defaultValue="false"
                     description="Write every DAP message of the Go debug sessions to the log directory of the IDE (delve/protocol); menu Go | Debugger | Trace Debugger Protocol"/>
        <!-- CPU, memory, heap, GC and scheduler of a running program: the operating system and the GODEBUG traces of the runtime -->
        <toolWindow id="Go Monitor" anchor="right" icon="/icons/goMonitorToolWindow.svg" factoryClass="io.github.golangsupport.monitor.GoMonitorToolWindowFactory"/>
        <toolWindow id="Go Tests" anchor="bottom" icon="/icons/goTestsToolWindow.svg" factoryClass="io.github.golangsupport.testing.GoTestExplorerToolWindowFactory"/>
        <postStartupActivity implementation="io.github.golangsupport.sdk.GoToolchainCheckActivity"/>
        <!-- a user/leftover association can shadow the declarative .go / go.mod one: tell the user in a dialog and offer to claim it back -->
        <postStartupActivity implementation="io.github.golangsupport.sdk.GoFileTypeCheckActivity"/>
        <!-- offer to switch off the bundled plugins a Go developer has no use for (Java, Maven, Python, Spring, GitHub, GitLab...) -->
        <postStartupActivity implementation="io.github.golangsupport.sdk.GoPluginAdvisorActivity"/>

        <configurationType implementation="io.github.golangsupport.run.GoConfigurationType"/>
        <runConfigurationProducer implementation="io.github.golangsupport.run.GoRunConfigurationProducer"/>
        <runLineMarkerContributor language="Go" implementationClass="io.github.golangsupport.run.GoRunLineMarkerContributor"/>
        <formattingService implementation="io.github.golangsupport.format.GoFormattingService"/>
        <actionOnSave implementation="io.github.golangsupport.format.GoFormatOnSave"/>
        <postStartupActivity implementation="io.github.golangsupport.run.GoRunConfigurationStartupActivity"/>
        <internalFileTemplate name="Go File"/>
        <internalFileTemplate name="Go Program"/>
        <internalFileTemplate name="Go Test"/>
        <defaultTemplatePropertiesProvider implementation="io.github.golangsupport.templates.GoTemplatePropertiesProvider"/>
        <!-- New Project, GoLand-style: GOROOT, module path, go mod init. The dialog of IntelliJ IDEA lists generator wizards, not directory generators -->
        <directoryProjectGenerator implementation="io.github.golangsupport.templates.GoProjectGenerator"/>
        <newProjectWizard.generator implementation="io.github.golangsupport.templates.GoNewProjectWizard"/>
        <!-- file.go:12 of the compiler, of tests and of panics, in every console of the project -->
        <consoleFilterProvider implementation="io.github.golangsupport.run.GoConsoleFilterProvider"/>
        <!-- golangci-lint on saved files -->
        <externalAnnotator language="Go" implementationClass="io.github.golangsupport.lint.GoLintAnnotator"/>
        <!-- the errors of the last Go | Build / Vet in the editor, where there is no language server to show them -->
        <externalAnnotator language="Go" implementationClass="io.github.golangsupport.build.GoBuildProblemsAnnotator"/>
    </extensions>

    <actions>
        <action id="Go.NewFile" class="io.github.golangsupport.templates.CreateGoFileAction">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>

        <!-- a menu of the main menu bar, next to Tools -->
        <group id="Go.MainMenu" text="_Go" popup="true">
            <action id="Go.Build" class="io.github.golangsupport.build.GoBuildAction" text="Build" icon="AllIcons.Actions.Compile"
                    description="go build ./... in every module of the project"/>
            <action id="Go.Vet" class="io.github.golangsupport.build.GoVetAction" text="Vet" description="go vet ./..."/>
            <action id="Go.Generate" class="io.github.golangsupport.build.GoGenerateAction" text="Generate" description="go generate ./..."/>
            <action id="Go.RebuildCatalogue" class="io.github.golangsupport.catalogue.GoRebuildCatalogueAction" text="Read Packages Again"
                    description="Read the exported names of the standard library and of the modules of go.mod from their sources again: what completion offers by a name"/>
            <action id="Go.Reanalyze" class="io.github.golangsupport.build.GoReanalyzeAction" text="Reanalyze Project"
                    description="Index the Go files again, restart the language server, read the packages again and highlight the open files anew, without a restart of the IDE"/>
            <separator/>
            <group id="Go.Modules" text="Modules" popup="true" icon="/icons/goMod.svg">
                <action id="Go.ModTidy" class="io.github.golangsupport.build.GoModTidyAction" text="Tidy" description="go mod tidy"/>
                <action id="Go.ModDownload" class="io.github.golangsupport.build.GoModDownloadAction" text="Download" icon="AllIcons.Actions.Download"
                        description="go mod download: the sources of the dependencies appear in the project tree"/>
                <action id="Go.ModVendor" class="io.github.golangsupport.build.GoModVendorAction" text="Vendor" description="go mod vendor"/>
                <separator/>
                <action id="Go.Dependencies" class="io.github.golangsupport.mod.GoDependenciesAction" text="Dependencies..." icon="AllIcons.Nodes.PpLibFolder"
                        description="The requirements of the module: newer versions, upgrades, govulncheck"/>
            </group>
            <action id="Go.NewModule" class="io.github.golangsupport.templates.NewGoModuleAction" text="New Go Module..." icon="/icons/goMod.svg"
                    description="go mod init in the selected directory"/>
            <separator/>
            <action id="Go.AnalyzeStackTrace" class="io.github.golangsupport.run.GoAnalyzeStackTraceAction" text="Analyze Stack Trace..."
                description="Paste a panic or a goroutine dump from a log: its file.go:12 frames become links"/>
            <action id="Go.OpenProfile" class="io.github.golangsupport.monitor.GoOpenProfileAction" text="Open Profile..."
                description="A pprof file in a tab of the editor: flame graph, top, graph, source"/>
        <separator/>
        <action id="Go.Environment" class="io.github.golangsupport.sdk.GoEnvironmentAction" text="Go on This Machine..."
                    description="The toolchain and the tools the plugin uses, the modules of the project, go env"/>
            <action id="Go.Optimize" class="io.github.golangsupport.sdk.GoDisablePluginsAction" text="Optimize IDE for Go..."
                    description="Switch off the bundled plugins a Go developer has no use for (Java, Maven, Python, Spring, GitHub, GitLab...) to keep the IDE light"/>
            <add-to-group group-id="MainMenu" anchor="after" relative-to-action="ToolsMenu"/>
        </group>

        <action id="Go.Monitor" class="io.github.golangsupport.monitor.ShowGoMonitorAction" text="Monitor Go Process" icon="/icons/goMonitorToolWindow.svg"
                description="CPU, memory, heap, garbage collections and goroutines of a running Go program">
            <add-to-group group-id="Go.MainMenu" anchor="last"/>
        </action>
        <group id="Go.GenerateGroup">
            <separator/>
            <action id="Go.Generate.Constructor" class="io.github.golangsupport.lang.GoGenerateConstructorAction" text="Constructor..." description="func NewT(...) *T for the struct at the caret"/>
            <action id="Go.Generate.Getters" class="io.github.golangsupport.lang.GoGenerateGettersAction" text="Getters..."/>
            <action id="Go.Generate.Setters" class="io.github.golangsupport.lang.GoGenerateSettersAction" text="Setters..."/>
            <action id="Go.Generate.GettersSetters" class="io.github.golangsupport.lang.GoGenerateGettersAndSettersAction" text="Getters and Setters..."/>
            <action id="Go.Generate.String" class="io.github.golangsupport.lang.GoGenerateStringAction" text="String() Method..."/>
            <action id="Go.Generate.Tags" class="io.github.golangsupport.lang.GoGenerateStructTagsAction" text="Struct Tags..."/>
            <action id="Go.Generate.Implement" class="io.github.golangsupport.lang.GoImplementInterfaceAction" text="Implement Interface..."/>
            <action id="Go.Generate.Test" class="io.github.golangsupport.lang.GoGenerateTestAction" text="Test"/>
            <action id="Go.Generate.TypeFromJson" class="io.github.golangsupport.lang.GoTypeFromJsonAction" text="Type from JSON..." description="Structs with json tags for a JSON document: the clipboard or a dialog"/>
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </group>
        <action id="Go.HelpPage" class="io.github.golangsupport.help.ShowGoHelpPageAction" text="Help Page" icon="AllIcons.Actions.Help"
                description="The keys, the actions, the settings and the features of the plugin, on one page">
            <add-to-group group-id="Go.MainMenu" anchor="last"/>
            <add-to-group group-id="HelpMenu" anchor="first"/>
        </action>
        <action id="Go.Welcome" class="io.github.golangsupport.help.ShowGoWelcomePageAction" text="Welcome to Go Project Support"
                description="What the plugin is for, with its features shown at work">
            <add-to-group group-id="Go.MainMenu" anchor="last"/>
        </action>
        <group id="Go.Debugger" text="Debugger" popup="true" icon="AllIcons.Actions.StartDebugger">
            <action id="Go.Debugger.AddFunctionBreakpoint" class="io.github.golangsupport.debugger.GoAddFunctionBreakpointAction" text="Add Function Breakpoint..."
                    description="A breakpoint on a function by its name, as delve names it; no file and line"/>
            <action id="Go.Debugger.ShowLogs" class="io.github.golangsupport.debugger.ShowDebuggerLogsAction" text="Show Debugger Logs"
                    description="Open the directory with the logs of delve and the traces of the protocol"/>
            <action id="Go.Debugger.TraceProtocol" class="io.github.golangsupport.debugger.TraceDebuggerProtocolAction" text="Trace Debugger Protocol"
                    description="Write every DAP message of the debug sessions that start from now on next to the debugger logs"/>
            <add-to-group group-id="Go.MainMenu" anchor="last"/>
        </group>
        <group id="Go.ProjectViewPopup">
            <separator/>
            <reference ref="Go.Build"/>
            <reference ref="Go.Vet"/>
            <reference ref="Go.ModTidy"/>
            <separator/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="WeighingNewGroup"/>
        </group>
    </actions>

    <applicationListeners>
        <!-- the plugin was enabled without a restart: offer the clean-up right away for the open Go projects -->
        <listener class="io.github.golangsupport.sdk.GoPluginAdvisorListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
        <!-- go.mod is being saved with other requirements: the banner with `go mod tidy` -->
        <listener class="io.github.golangsupport.mod.GoModSaveListener" topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="io.github.golangsupport.testing.GoTestStatuses$Listener" topic="com.intellij.execution.testframework.sm.runner.SMTRunnerEventsListener"/>
        <listener class="io.github.golangsupport.monitor.GoProcessStartListener" topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
</idea-plugin>
