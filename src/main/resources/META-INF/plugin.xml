<idea-plugin>
    <id>io.github.golangsupport</id>
    <name>Go Project Support</name>
    <vendor>dvislobokov</vendor>

    <description><![CDATA[
        Go support for IntelliJ-based IDEs that have none, built on the tools of the Go ecosystem:
        <ul>
            <li><b>gopls</b> for errors, completion, navigation and refactorings (the LSP client of the platform)</li>
            <li><b>delve</b> behind the Debug button (the DAP client of the platform)</li>
            <li>the <b>go</b> command: build, vet, run, test with a test tree, modules and their dependencies</li>
            <li>gofmt / goimports behind Reformat Code</li>
            <li>syntax highlighting, Structure view, folding, Go to Symbol that work without any tool</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- GoLand, or the JetBrains Go plugin in IntelliJ IDEA: the same file type, and nothing this plugin could add -->
    <incompatible-with>org.jetbrains.plugins.go</incompatible-with>

    <!-- optional parts: a module is loaded only where its dependencies are (see the descriptor of the module next to META-INF) -->
    <content>
        <module name="io.github.golangsupport.lsp"/>
        <module name="io.github.golangsupport.dap"/>
    </content>

    <extensionPoints>
        <!-- restarts the language server when its settings change: the module with gopls, where it is loaded -->
        <extensionPoint qualifiedName="io.github.golangsupport.languageServerControl" interface="io.github.golangsupport.settings.GoLanguageServerControl" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Go" implementationClass="io.github.golangsupport.lang.GoFileType" fieldName="INSTANCE" language="Go" extensions="go"/>
        <fileType name="Go Module" implementationClass="io.github.golangsupport.mod.GoModFileType" fieldName="INSTANCE" language="GoModule"
                  fileNames="go.mod;go.work"/>
        <fileIconProvider implementation="io.github.golangsupport.view.GoFileIconProvider"/>

        <lang.parserDefinition language="Go" implementationClass="io.github.golangsupport.lang.GoParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Go" implementationClass="io.github.golangsupport.lang.GoSyntaxHighlighterFactory"/>
        <annotator language="Go" implementationClass="io.github.golangsupport.lang.GoIdentifierAnnotator"/>
        <!-- on the declarations GoDeclarations finds by tokens -->
        <lang.psiStructureViewFactory language="Go" implementationClass="io.github.golangsupport.lang.GoStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="io.github.golangsupport.lang.GoBreadcrumbsProvider"/>
        <lang.foldingBuilder language="Go" implementationClass="io.github.golangsupport.lang.GoFoldingBuilder"/>
        <fileBasedIndex implementation="io.github.golangsupport.lang.GoDeclarationIndex"/>
        <gotoClassContributor implementation="io.github.golangsupport.lang.GoGotoClassContributor"/>
        <gotoSymbolContributor implementation="io.github.golangsupport.lang.GoGotoSymbolContributor"/>
        <lang.commenter language="Go" implementationClass="io.github.golangsupport.lang.GoCommenter"/>
        <lang.braceMatcher language="Go" implementationClass="io.github.golangsupport.lang.GoBraceMatcher"/>
        <lang.quoteHandler language="Go" implementationClass="io.github.golangsupport.lang.GoQuoteHandler"/>
        <colorSettingsPage implementation="io.github.golangsupport.lang.GoColorSettingsPage"/>
        <defaultLiveTemplates file="/liveTemplates/Go.xml"/>
        <liveTemplateContext contextId="GO" implementation="io.github.golangsupport.lang.GoTemplateContext"/>
        <liveTemplateMacro implementation="io.github.golangsupport.lang.GoTypeNameMacro"/>

        <lang.parserDefinition language="GoModule" implementationClass="io.github.golangsupport.mod.GoModParserDefinition"/>
        <lang.syntaxHighlighterFactory language="GoModule" implementationClass="io.github.golangsupport.mod.GoModSyntaxHighlighterFactory"/>
        <lang.commenter language="GoModule" implementationClass="io.github.golangsupport.mod.GoModCommenter"/>

        <treeStructureProvider implementation="io.github.golangsupport.view.GoDependenciesTreeProvider"/>
        <notificationGroup id="Go" displayType="BALLOON"/>
        <projectConfigurable parentId="tools" id="io.github.golangsupport.settings" displayName="Go"
                             instance="io.github.golangsupport.settings.GoSettingsConfigurable"/>

        <configurationType implementation="io.github.golangsupport.run.GoConfigurationType"/>
        <runConfigurationProducer implementation="io.github.golangsupport.run.GoRunConfigurationProducer"/>
        <runLineMarkerContributor language="Go" implementationClass="io.github.golangsupport.run.GoRunLineMarkerContributor"/>
        <formattingService implementation="io.github.golangsupport.format.GoFormattingService"/>
    </extensions>

    <actions>
        <!-- a menu of the main menu bar, next to Tools -->
        <group id="Go.MainMenu" text="_Go" popup="true">
            <action id="Go.Build" class="io.github.golangsupport.build.GoBuildAction" text="Build" icon="AllIcons.Actions.Compile"
                    description="go build ./... in every module of the project"/>
            <action id="Go.Vet" class="io.github.golangsupport.build.GoVetAction" text="Vet" description="go vet ./..."/>
            <action id="Go.Generate" class="io.github.golangsupport.build.GoGenerateAction" text="Generate" description="go generate ./..."/>
            <separator/>
            <group id="Go.Modules" text="Modules" popup="true" icon="/icons/goMod.svg">
                <action id="Go.ModTidy" class="io.github.golangsupport.build.GoModTidyAction" text="Tidy" description="go mod tidy"/>
                <action id="Go.ModDownload" class="io.github.golangsupport.build.GoModDownloadAction" text="Download" icon="AllIcons.Actions.Download"
                        description="go mod download: the sources of the dependencies appear in the project tree"/>
                <action id="Go.ModVendor" class="io.github.golangsupport.build.GoModVendorAction" text="Vendor" description="go mod vendor"/>
            </group>
            <add-to-group group-id="MainMenu" anchor="after" relative-to-action="ToolsMenu"/>
        </group>

        <group id="Go.ProjectViewPopup">
            <separator/>
            <reference ref="Go.Build"/>
            <reference ref="Go.Vet"/>
            <reference ref="Go.ModTidy"/>
            <separator/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="WeighingNewGroup"/>
        </group>
    </actions>
</idea-plugin>
