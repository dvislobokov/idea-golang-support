<!-- Smart Completion: the ML ranking of completion candidates (docs/ML.md). Part of the plugin only when it is built with
     -PmlEnabled=true (or MLENABLED=true in the environment): the build copies this file and the models ml/go/{lm.cml,rank.cml}
     into the resources; plugin.xml includes it with an xi:fallback, so a build without it has no ranker and no settings page. -->
<idea-plugin>
  <extensions defaultExtensionNs="io.github.golangsupport">
    <completionRanker implementation="io.github.golangsupport.ml.GoMlCompletionRanker"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <projectConfigurable parentId="io.github.golangsupport.settings" groupWeight="35" id="io.github.golangsupport.settings.ml" bundle="messages.GoSettingsTitles" key="page.ml"
                         instance="io.github.golangsupport.settings.GoMlConfigurable"/>
  </extensions>
</idea-plugin>
