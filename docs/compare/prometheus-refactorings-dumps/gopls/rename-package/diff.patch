+package kahan
+
+import (
+	"math"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestIsInf(t *testing.T) {
+	for _, f := range []float64{
+		math.Inf(1),
+		math.Inf(-1),
+		math.MaxFloat64,
+		-math.MaxFloat64,
+		1.0,
+		-1.0,
+		0,
+		math.NaN(),
+	} {
+		require.Equal(t, math.IsInf(f, 0), isInf(f), "%e", f)
+	}
+}
