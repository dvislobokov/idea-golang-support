<!-- Test-only descriptor so that go-psi-ide tests see the core and IDE extensions without the plugin module. -->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <id>io.github.golangsupport.ide.test</id>
  <name>Go PSI IDE (tests)</name>
  <vendor>Go Project Support</vendor>
  <depends>com.intellij.modules.platform</depends>

  <xi:include href="/META-INF/go-psi-core.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-semantic.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide.xml" xpointer="xpointer(/idea-plugin/*)"/>
</idea-plugin>
