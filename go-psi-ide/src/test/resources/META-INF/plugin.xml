<!-- Test-only descriptor so that go-psi-ide tests see the core and IDE extensions without the plugin module. -->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <id>io.github.golangsupport.ide.test</id>
  <name>Go PSI IDE (tests)</name>
  <vendor>Go Project Support</vendor>
  <depends>com.intellij.modules.platform</depends>

  <xi:include href="/META-INF/go-psi-core.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-core-language.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-semantic.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-semantic-roots.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-editor.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-formatter.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-navigation.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-refactoring.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-documentation.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-completion.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-inspections.xml" xpointer="xpointer(/idea-plugin/*)"/>
  <xi:include href="/META-INF/go-psi-ide-highlighting.xml" xpointer="xpointer(/idea-plugin/*)"/>

  <extensions defaultExtensionNs="com.intellij">
    <!-- The plugin's highlighter is the root module's; editor features under test need one over the PSI lexer. -->
    <lang.syntaxHighlighterFactory language="Go" implementationClass="io.github.golangsupport.ide.GoTestSyntaxHighlighterFactory"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="Go" language="Go" extensions="go" implementationClass="io.github.golangsupport.lang.GoFileType" fieldName="INSTANCE"/>
  </extensions>
</idea-plugin>
