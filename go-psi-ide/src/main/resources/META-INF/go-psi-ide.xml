<!-- Extensions contributed by go-psi-ide. Included into plugin/src/main/resources/META-INF/plugin.xml. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <lang.syntaxHighlighterFactory language="Go"
                                   implementationClass="io.github.golangsupport.ide.highlighting.GoSyntaxHighlighterFactory"/>
    <colorSettingsPage implementation="io.github.golangsupport.ide.highlighting.GoColorSettingsPage"/>

    <!-- Phase 6a: syntax-level editor features. -->
    <lang.braceMatcher language="Go" implementationClass="io.github.golangsupport.ide.editor.GoBraceMatcher"/>
    <lang.quoteHandler language="Go" implementationClass="io.github.golangsupport.ide.editor.GoQuoteHandler"/>
    <lang.commenter language="Go" implementationClass="io.github.golangsupport.ide.editor.GoCommenter"/>
    <indexPatternBuilder implementation="io.github.golangsupport.ide.editor.GoIndexPatternBuilder"/>
    <lang.findUsagesProvider language="Go" implementationClass="io.github.golangsupport.ide.editor.GoFindUsagesProvider"/>
    <lang.foldingBuilder language="Go" implementationClass="io.github.golangsupport.ide.folding.GoFoldingBuilder"/>
    <lang.psiStructureViewFactory language="Go"
                                  implementationClass="io.github.golangsupport.ide.structure.GoStructureViewFactory"/>
    <breadcrumbsInfoProvider implementation="io.github.golangsupport.ide.structure.GoBreadcrumbsProvider"/>
    <itemPresentationProvider forClass="io.github.golangsupport.lang.psi.GoNamedElement"
                              implementationClass="io.github.golangsupport.ide.navigation.GoItemPresentationProvider"/>
    <gotoSymbolContributor implementation="io.github.golangsupport.ide.navigation.GoGotoSymbolContributor"/>
    <gotoClassContributor implementation="io.github.golangsupport.ide.navigation.GoGotoClassContributor"/>

    <!-- Phase 6b: gofmt-compatible formatter. -->
    <lang.formatter language="Go" implementationClass="io.github.golangsupport.ide.formatter.GoFormattingModelBuilder"/>
    <langCodeStyleSettingsProvider implementation="io.github.golangsupport.ide.formatter.GoLanguageCodeStyleSettingsProvider"/>
    <codeStyleSettingsProvider implementation="io.github.golangsupport.ide.formatter.GoCodeStyleSettingsProvider"/>
    <preFormatProcessor implementation="io.github.golangsupport.ide.formatter.GoImportSorter"/>
    <postFormatProcessor implementation="io.github.golangsupport.ide.formatter.GoFileEdgesPostFormatProcessor"/>

    <!-- Phase 6c: navigation, usages, rename, documentation (docs/IDE-FEATURES.md). -->
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoReferenceExpression"
                             implementationClass="io.github.golangsupport.ide.rename.GoReferenceExpressionManipulator"/>
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoTypeReferenceExpression"
                             implementationClass="io.github.golangsupport.ide.rename.GoTypeReferenceExpressionManipulator"/>
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoLabelRef"
                             implementationClass="io.github.golangsupport.ide.rename.GoLabelRefManipulator"/>
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoImportSpec"
                             implementationClass="io.github.golangsupport.ide.rename.GoImportSpecManipulator"/>

    <typeDeclarationProvider implementation="io.github.golangsupport.ide.navigation.GoTypeDeclarationProvider"/>
    <definitionsScopedSearch implementation="io.github.golangsupport.ide.navigation.GoImplementationSearch"/>
    <targetElementEvaluator language="Go" implementationClass="io.github.golangsupport.ide.navigation.GoTargetElementEvaluator"/>
    <codeInsight.gotoSuper language="Go" implementationClass="io.github.golangsupport.ide.navigation.GoGotoSuperHandler"/>
    <codeInsight.lineMarkerProvider language="Go"
                                    implementationClass="io.github.golangsupport.ide.navigation.GoImplementationLineMarkerProvider"/>

    <referencesSearch implementation="io.github.golangsupport.ide.usages.GoReferencesSearch"/>
    <usageTypeProvider implementation="io.github.golangsupport.ide.usages.GoUsageTypeProvider"/>
    <readWriteAccessDetector implementation="io.github.golangsupport.ide.usages.GoReadWriteAccessDetector"/>
    <findUsagesHandlerFactory implementation="io.github.golangsupport.ide.usages.GoFindUsagesHandlerFactory"/>
    <highlightUsagesHandlerFactory implementation="io.github.golangsupport.ide.usages.GoHighlightExitPointsHandlerFactory"/>

    <lang.refactoringSupport language="Go" implementationClass="io.github.golangsupport.ide.rename.GoRefactoringSupportProvider"/>
    <lang.namesValidator language="Go" implementationClass="io.github.golangsupport.ide.rename.GoNamesValidator"/>
    <renameInputValidator implementation="io.github.golangsupport.ide.rename.GoRenameInputValidator"/>
    <renamePsiElementProcessor implementation="io.github.golangsupport.ide.rename.GoRenameMethodProcessor"/>

    <platform.backend.documentation.psiTargetProvider
        implementation="io.github.golangsupport.ide.documentation.GoDocumentationTargetProvider"/>
    <codeInsight.parameterInfo language="Go" implementationClass="io.github.golangsupport.ide.documentation.GoParameterInfoHandler"/>
    <expressionTypeProvider language="Go" implementationClass="io.github.golangsupport.ide.documentation.GoExpressionTypeProvider"/>

    <!-- Phase 6d: completion (docs/IDE-FEATURES.md). -->
    <completion.contributor language="Go" order="first"
                            implementationClass="io.github.golangsupport.ide.completion.GoCompletionContributor"/>
    <completion.confidence language="Go" order="first"
                           implementationClass="io.github.golangsupport.ide.completion.GoCompletionConfidence"/>
    <weigher key="completion" id="goCompletion" order="after priority, before prefix"
             implementationClass="io.github.golangsupport.ide.completion.GoCompletionWeigher"/>
    <weigher key="completion" id="goAlphabetical" order="after proximity, before grouping"
             implementationClass="io.github.golangsupport.ide.completion.GoAlphabeticalWeigher"/>

    <!-- Phase 6d: inspections over GoSemanticService.check, quick fixes, semantic highlighting (docs/IDE-FEATURES.md). -->
    <annotator language="Go" implementationClass="io.github.golangsupport.ide.annotator.GoSemanticHighlightingAnnotator"/>
    <lang.inspectionSuppressor language="Go" implementationClass="io.github.golangsupport.ide.inspections.GoInspectionSuppressor"/>
    <lang.importOptimizer language="Go" implementationClass="io.github.golangsupport.ide.inspections.GoImportOptimizer"/>
    <localInspection language="Go" shortName="GoUnresolvedReference" displayName="Unresolved reference"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnresolvedReferenceInspection"/>
    <localInspection language="Go" shortName="GoUnusedImport" displayName="Unused import"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedImportInspection"/>
    <localInspection language="Go" shortName="GoUnusedVariable" displayName="Unused variable"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedVariableInspection"/>
    <localInspection language="Go" shortName="GoUnusedLabel" displayName="Unused label"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedLabelInspection"/>
    <localInspection language="Go" shortName="GoTypeMismatch" displayName="Type mismatch"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoTypeMismatchInspection"/>
    <localInspection language="Go" shortName="GoCallArity" displayName="Wrong number of arguments or values"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoCallArityInspection"/>
    <localInspection language="Go" shortName="GoDuplicateDeclaration" displayName="Duplicate declaration"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoDuplicateDeclarationInspection"/>
    <localInspection language="Go" shortName="GoGenerics" displayName="Generic instantiation and constraint errors"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoGenericsInspection"/>
    <localInspection language="Go" shortName="GoMissingReturn" displayName="Missing return"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoMissingReturnInspection"/>
    <localInspection language="Go" shortName="GoChecker" displayName="Other type-checker errors"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoCheckerInspection"/>
  </extensions>

  <!-- Warns once per session about plugins that register Go extensions under language="go" instead of "Go". -->
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="io.github.golangsupport.ide.startup.GoLanguageIdCheckActivity"/>
  </extensions>

  <extensionPoints>
    <!-- Optional re-ranking of completion candidates (docs/ML.md section 2); no implementation in go-psi. -->
    <extensionPoint qualifiedName="io.github.golangsupport.completionRanker"
                    interface="io.github.golangsupport.ide.completion.api.GoCompletionRanker" dynamic="true"/>
  </extensionPoints>
</idea-plugin>
