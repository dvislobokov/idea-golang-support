<!-- go-psi-ide, documentation: quick doc, parameter info, expression type, doc links.
     Included by the host plugin when the feature moves to the PSI (MIGRATION.md, step 8); the tests of go-psi-ide include every go-psi-ide-*.xml. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <platform.backend.documentation.psiTargetProvider
        implementation="io.github.golangsupport.ide.documentation.GoDocumentationTargetProvider"/>
    <codeInsight.parameterInfo language="Go" implementationClass="io.github.golangsupport.ide.documentation.GoParameterInfoHandler"/>
    <expressionTypeProvider language="Go" implementationClass="io.github.golangsupport.ide.documentation.GoExpressionTypeProvider"/>
    <!-- doc links ([Name], [pkg.Name], [Type.Method]) in Quick Documentation, and as references of comments: Ctrl+click, usages, rename -->
    <platform.backend.documentation.linkHandler implementation="io.github.golangsupport.ide.documentation.GoDocLinkHandler"/>
    <psi.referenceContributor language="Go" implementation="io.github.golangsupport.ide.documentation.GoDocLinkReferenceContributor"/>
    <!-- //go:embed patterns, //go:linkname names and //go:generate paths as references of comments -->
    <psi.referenceContributor language="Go" implementation="io.github.golangsupport.ide.directives.GoDirectiveReferenceContributor"/>
  </extensions>
</idea-plugin>
