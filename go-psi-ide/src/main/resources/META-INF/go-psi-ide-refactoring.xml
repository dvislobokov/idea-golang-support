<!-- go-psi-ide, rename: element manipulators, refactoring support, names validator, rename processors.
     Included by the host plugin when the feature moves to the PSI (MIGRATION.md, step 8); the tests of go-psi-ide include every go-psi-ide-*.xml. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoReferenceExpression"
                             implementationClass="io.github.golangsupport.ide.rename.GoReferenceExpressionManipulator"/>
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoTypeReferenceExpression"
                             implementationClass="io.github.golangsupport.ide.rename.GoTypeReferenceExpressionManipulator"/>
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoLabelRef"
                             implementationClass="io.github.golangsupport.ide.rename.GoLabelRefManipulator"/>
    <lang.elementManipulator forClass="io.github.golangsupport.lang.psi.GoImportSpec"
                             implementationClass="io.github.golangsupport.ide.rename.GoImportSpecManipulator"/>
    <lang.refactoringSupport language="Go" implementationClass="io.github.golangsupport.ide.rename.GoRefactoringSupportProvider"/>
    <lang.namesValidator language="Go" implementationClass="io.github.golangsupport.ide.rename.GoNamesValidator"/>
    <renameInputValidator implementation="io.github.golangsupport.ide.rename.GoRenameInputValidator"/>
    <renamePsiElementProcessor implementation="io.github.golangsupport.ide.rename.GoRenameMethodProcessor"/>
    <renamePsiElementProcessor implementation="io.github.golangsupport.ide.rename.GoRenamePackageProcessor" order="first"/>
    <vetoRenameCondition implementation="io.github.golangsupport.ide.rename.GoLibraryPackageRenameVeto"/>
    <!-- linked renames with GoLand's Ask / Always / Never (GoIdeOptions): foo.go <-> foo_test.go, a field's struct tag names -->
    <automaticRenamerFactory implementation="io.github.golangsupport.ide.rename.GoTestFileRenamerFactory"/>
    <automaticRenamerFactory implementation="io.github.golangsupport.ide.rename.GoStructTagRenamerFactory"/>
    <refactoring.safeDeleteProcessor implementation="io.github.golangsupport.ide.refactoring.GoSafeDeleteProcessor"/>
    <inlineActionHandler implementation="io.github.golangsupport.ide.refactoring.GoInlineActionHandler"/>
    <refactoring.moveHandler implementation="io.github.golangsupport.ide.refactoring.GoMoveHandler" id="goMoveDeclarations" order="before moveFileOrDir"/>
    <intentionAction>
      <language>Go</language>
      <className>io.github.golangsupport.ide.refactoring.GoAddInterfaceMethodIntention</className>
      <category>Go</category>
      <descriptionDirectoryName>GoAddInterfaceMethodIntention</descriptionDirectoryName>
    </intentionAction>
  </extensions>
</idea-plugin>
