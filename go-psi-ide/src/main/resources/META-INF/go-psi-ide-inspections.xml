<!-- go-psi-ide, inspections: the inspections over GoSemanticService.check with their quick fixes, the suppressor and the import optimizer
     (the semantic highlighting annotator is go-psi-ide-highlighting.xml). Included by the host plugin when the feature moves to the PSI
     (MIGRATION.md, step 8g; the inspections and the optimizer ask GoIdeFeatureGate for DIAGNOSTICS first); the tests of go-psi-ide include every go-psi-ide-*.xml. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Phase 6d: inspections over GoSemanticService.check, quick fixes (docs/IDE-FEATURES.md). -->
    <lang.inspectionSuppressor language="Go" implementationClass="io.github.golangsupport.ide.inspections.GoInspectionSuppressor"/>
    <lang.importOptimizer language="Go" implementationClass="io.github.golangsupport.ide.inspections.GoImportOptimizer"/>
    <localInspection language="Go" shortName="GoUnresolvedReference" displayName="Unresolved reference"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnresolvedReferenceInspection"/>
    <localInspection language="Go" shortName="GoUnusedImport" displayName="Unused import"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedImportInspection"/>
    <localInspection language="Go" shortName="GoUnusedVariable" displayName="Unused variable"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedVariableInspection"/>
    <localInspection language="Go" shortName="GoUnusedLabel" displayName="Unused label"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedLabelInspection"/>
    <localInspection language="Go" shortName="GoTypeMismatch" displayName="Type mismatch"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoTypeMismatchInspection"/>
    <localInspection language="Go" shortName="GoCallArity" displayName="Wrong number of arguments or values"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoCallArityInspection"/>
    <localInspection language="Go" shortName="GoDuplicateDeclaration" displayName="Duplicate declaration"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoDuplicateDeclarationInspection"/>
    <localInspection language="Go" shortName="GoGenerics" displayName="Generic instantiation and constraint errors"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoGenericsInspection"/>
    <localInspection language="Go" shortName="GoMissingReturn" displayName="Missing return"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoMissingReturnInspection"/>
    <!-- vet printf over the PSI (docs/FEATURES.md section 5): format against arguments of fmt/log/testing calls and package wrappers. -->
    <localInspection language="Go" shortName="GoPrintf" displayName="Printf format and arguments"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoPrintfInspection"/>
    <localInspection language="Go" shortName="GoChecker" displayName="Other type-checker errors"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoCheckerInspection"/>
    <!-- Wave 2 (docs/FEATURES.md §11), part E: analysis inspections over the PSI (GoAnalysisInspectionBase, gate DIAGNOSTICS). -->
    <localInspection language="Go" shortName="GoExhaustiveSwitch" displayName="Non-exhaustive switch over an enum or interface"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoExhaustiveSwitchInspection"/>
    <localInspection language="Go" shortName="GoDocComment" displayName="Missing or malformed doc comment of an exported declaration"
                     groupName="Go" enabledByDefault="false" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoDocCommentInspection"/>
    <localInspection language="Go" shortName="GoEmbedDirective" displayName="Invalid //go:embed directive"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.directives.GoEmbedDirectiveInspection"/>
    <localInspection language="Go" shortName="GoStructTag" displayName="Malformed or duplicate struct tag"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoStructTagInspection"/>
    <localInspection language="Go" shortName="GoContextPlacement" displayName="context.Context not first, lost or replaced"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoContextPlacementInspection"/>
    <localInspection language="Go" shortName="GoErrorsPackage" displayName="Misuse of errors.As and comparison with sentinel errors"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoErrorsPackageInspection"/>
    <!-- data flow (semantic.flow) -->
    <localInspection language="Go" shortName="GoErrorOverwritten" displayName="Error overwritten before it is checked"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoErrorOverwrittenInspection"/>
    <localInspection language="Go" shortName="GoWrongErrorChecked" displayName="Another error variable is checked"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoWrongErrorCheckedInspection"/>
    <localInspection language="Go" shortName="GoNilErrorReturn" displayName="Nil returned while the error is not nil"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoNilErrorReturnInspection"/>
    <localInspection language="Go" shortName="GoDeferBeforeErrorCheck" displayName="Deferred call before the error check"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoDeferBeforeErrorCheckInspection"/>
    <localInspection language="Go" shortName="GoNilDereference" displayName="Nil dereference"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoNilDereferenceInspection"/>
    <localInspection language="Go" shortName="GoIneffectualAssignment" displayName="Ineffectual assignment"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoIneffectualAssignmentInspection"/>
    <localInspection language="Go" shortName="GoLostCancel" displayName="Lost context cancel function"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoLostCancelInspection"/>
    <localInspection language="Go" shortName="GoBodyNotClosed" displayName="HTTP response body is not closed"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoBodyNotClosedInspection"/>
    <localInspection language="Go" shortName="GoRowsNotClosed" displayName="SQL rows are not closed"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoRowsNotClosedInspection"/>
    <localInspection language="Go" shortName="GoLockNotReleased" displayName="Mutex is not unlocked on all paths"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoLockNotReleasedInspection"/>
    <localInspection language="Go" shortName="GoSendAfterClose" displayName="Send on a closed channel"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoSendAfterCloseInspection"/>
    <localInspection language="Go" shortName="GoWaitGroupAddInGoroutine" displayName="WaitGroup.Add inside the goroutine"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoWaitGroupAddInGoroutineInspection"/>
    <localInspection language="Go" shortName="GoContextNotPropagated" displayName="Context is not propagated"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoContextNotPropagatedInspection"/>
    <localInspection language="Go" shortName="GoBuildConstraint" displayName="Build constraint comments"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoBuildConstraintInspection"/>
    <localInspection language="Go" shortName="GoTimeLayout" displayName="Time layout"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoTimeLayoutInspection"/>
    <localInspection language="Go" shortName="GoSelfAssignment" displayName="Self-assignment"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoSelfAssignmentInspection"/>
    <localInspection language="Go" shortName="GoUnusedResult" displayName="Unused result"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoUnusedResultInspection"/>
    <!-- errcheck while typing; not gated by DIAGNOSTICS: gopls does not report unchecked errors (GoUncheckedErrorInspection) -->
    <localInspection language="Go" shortName="GoUncheckedError" displayName="Unchecked error"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoUncheckedErrorInspection"/>
    <localInspection language="Go" shortName="GoDeferInLoop" displayName="Defer in loop"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoDeferInLoopInspection"/>
    <localInspection language="Go" shortName="GoCopyLocks" displayName="Lock copied by value"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoCopyLocksInspection"/>
    <localInspection language="Go" shortName="GoLoopClosure" displayName="Loop variable captured by closure"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoLoopClosureInspection"/>
    <localInspection language="Go" shortName="GoTestingGoroutine" displayName="Test failure from a goroutine"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoTestingGoroutineInspection"/>
    <localInspection language="Go" shortName="GoUnusedParameter" displayName="Unused parameter"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.lint.GoUnusedParameterInspection"/>
    <localInspection language="Go" shortName="GoErrNilReturned" displayName="Nil error returned where it is known to be nil"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoErrNilReturnedInspection"/>
    <localInspection language="Go" shortName="GoShadowedError" displayName="Shadowed error"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoShadowedErrorInspection"/>
    <localInspection language="Go" shortName="GoResultUsedBeforeErrorCheck" displayName="Result used before the error check"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoResultUsedBeforeErrorCheckInspection"/>
    <localInspection language="Go" shortName="GoImpossibleNilCheck" displayName="Impossible nil check"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoImpossibleNilCheckInspection"/>
    <localInspection language="Go" shortName="GoNilValueNilError" displayName="Nil value returned with a nil error"
                     groupName="Go" enabledByDefault="false" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoNilValueNilErrorInspection"/>
    <localInspection language="Go" shortName="GoUnreachableCode" displayName="Unreachable code"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.flow.GoUnreachableCodeInspection"/>
    <!-- Project-wide checks (docs/FEATURES.md section 5): internal/ visibility, import cycles, unused exported declarations. -->
    <localInspection language="Go" shortName="GoInternalImport" displayName="Use of an internal package"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.project.GoInternalImportInspection"/>
    <localInspection language="Go" shortName="GoImportCycle" displayName="Import cycle"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.project.GoImportCycleInspection"/>
    <localInspection language="Go" shortName="GoUnusedExported" displayName="Unused exported declaration"
                     groupName="Go" enabledByDefault="false" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.project.GoUnusedExportedInspection"/>
  </extensions>
</idea-plugin>
