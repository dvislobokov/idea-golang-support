<!-- go-psi-ide, inspections: the inspections over GoSemanticService.check with their quick fixes, the suppressor and the import optimizer
     (the semantic highlighting annotator is go-psi-ide-highlighting.xml). Included by the host plugin when the feature moves to the PSI
     (MIGRATION.md, step 8g; the inspections and the optimizer ask GoIdeFeatureGate for DIAGNOSTICS first); the tests of go-psi-ide include every go-psi-ide-*.xml. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Phase 6d: inspections over GoSemanticService.check, quick fixes (docs/IDE-FEATURES.md). -->
    <lang.inspectionSuppressor language="Go" implementationClass="io.github.golangsupport.ide.inspections.GoInspectionSuppressor"/>
    <lang.importOptimizer language="Go" implementationClass="io.github.golangsupport.ide.inspections.GoImportOptimizer"/>
    <localInspection language="Go" shortName="GoUnresolvedReference" displayName="Unresolved reference"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnresolvedReferenceInspection"/>
    <localInspection language="Go" shortName="GoUnusedImport" displayName="Unused import"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedImportInspection"/>
    <localInspection language="Go" shortName="GoUnusedVariable" displayName="Unused variable"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedVariableInspection"/>
    <localInspection language="Go" shortName="GoUnusedLabel" displayName="Unused label"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoUnusedLabelInspection"/>
    <localInspection language="Go" shortName="GoTypeMismatch" displayName="Type mismatch"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoTypeMismatchInspection"/>
    <localInspection language="Go" shortName="GoCallArity" displayName="Wrong number of arguments or values"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoCallArityInspection"/>
    <localInspection language="Go" shortName="GoDuplicateDeclaration" displayName="Duplicate declaration"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoDuplicateDeclarationInspection"/>
    <localInspection language="Go" shortName="GoGenerics" displayName="Generic instantiation and constraint errors"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoGenericsInspection"/>
    <localInspection language="Go" shortName="GoMissingReturn" displayName="Missing return"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoMissingReturnInspection"/>
    <!-- vet printf over the PSI (docs/FEATURES.md section 5): format against arguments of fmt/log/testing calls and package wrappers. -->
    <localInspection language="Go" shortName="GoPrintf" displayName="Printf format and arguments"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoPrintfInspection"/>
    <localInspection language="Go" shortName="GoChecker" displayName="Other type-checker errors"
                     groupName="Go" enabledByDefault="true" level="ERROR"
                     implementationClass="io.github.golangsupport.ide.inspections.GoCheckerInspection"/>
    <!-- Wave 2 (docs/FEATURES.md §11), part E: analysis inspections over the PSI (GoAnalysisInspectionBase, gate DIAGNOSTICS). -->
    <localInspection language="Go" shortName="GoExhaustiveSwitch" displayName="Non-exhaustive switch over an enum or interface"
                     groupName="Go" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoExhaustiveSwitchInspection"/>
    <localInspection language="Go" shortName="GoDocComment" displayName="Missing or malformed doc comment of an exported declaration"
                     groupName="Go" enabledByDefault="false" level="WEAK WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoDocCommentInspection"/>
    <localInspection language="Go" shortName="GoStructTag" displayName="Malformed or duplicate struct tag"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoStructTagInspection"/>
    <localInspection language="Go" shortName="GoContextPlacement" displayName="context.Context not first, lost or replaced"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoContextPlacementInspection"/>
    <localInspection language="Go" shortName="GoErrorsPackage" displayName="Misuse of errors.As and comparison with sentinel errors"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoErrorsPackageInspection"/>
    <localInspection language="Go" shortName="GoBuildConstraint" displayName="Build constraint comments"
                     groupName="Go" enabledByDefault="true" level="WARNING"
                     implementationClass="io.github.golangsupport.ide.inspections.GoBuildConstraintInspection"/>
  </extensions>
</idea-plugin>
