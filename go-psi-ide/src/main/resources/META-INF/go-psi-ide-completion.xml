<!-- go-psi-ide, completion: contributor, confidence, weighers, and the completionRanker extension point.
     Included by the host plugin when the feature moves to the PSI (MIGRATION.md, step 8); the tests of go-psi-ide include every go-psi-ide-*.xml. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Phase 6d: completion (docs/IDE-FEATURES.md). -->
    <completion.contributor language="Go" id="goPsiCompletion" order="first"
                            implementationClass="io.github.golangsupport.ide.completion.GoCompletionContributor"/>
    <completion.confidence language="Go" order="first"
                           implementationClass="io.github.golangsupport.ide.completion.GoCompletionConfidence"/>
    <weigher key="completion" id="goCompletion" order="after priority, before prefix"
             implementationClass="io.github.golangsupport.ide.completion.GoCompletionWeigher"/>
    <weigher key="completion" id="goAlphabetical" order="after proximity, before grouping"
             implementationClass="io.github.golangsupport.ide.completion.GoAlphabeticalWeigher"/>

  </extensions>
  <extensionPoints>
    <!-- Optional re-ranking of completion candidates (docs/ML.md section 2); no implementation in go-psi. -->
    <extensionPoint qualifiedName="io.github.golangsupport.completionRanker"
                    interface="io.github.golangsupport.ide.completion.api.GoCompletionRanker" dynamic="true"/>
  </extensionPoints>
</idea-plugin>
