<!-- go-psi-ide, completion: contributor, confidence, weighers, and the completionRanker extension point.
     Included by the host plugin when the feature moves to the PSI (MIGRATION.md, step 8); the tests of go-psi-ide include every go-psi-ide-*.xml. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Phase 6d: completion (docs/IDE-FEATURES.md). -->
    <completion.contributor language="Go" id="goPsiCompletion" order="first"
                            implementationClass="io.github.golangsupport.ide.completion.GoCompletionContributor"/>
    <completion.confidence language="Go" order="first"
                           implementationClass="io.github.golangsupport.ide.completion.GoCompletionConfidence"/>
    <!-- Comments: package names in top-level comments (explicit completion; the confidence keeps the popup off), files after //go:embed. -->
    <completion.contributor language="Go" id="goCommentCompletion"
                            implementationClass="io.github.golangsupport.ide.completion.GoCommentCompletionContributor"/>
    <completion.contributor language="Go" id="goEmbedCompletion"
                            implementationClass="io.github.golangsupport.ide.directives.GoEmbedCompletionContributor"/>
    <weigher key="completion" id="goCompletion" order="after priority, before prefix"
             implementationClass="io.github.golangsupport.ide.completion.GoCompletionWeigher"/>
    <weigher key="completion" id="goAlphabetical" order="after proximity, before grouping"
             implementationClass="io.github.golangsupport.ide.completion.GoAlphabeticalWeigher"/>
    <!-- Printf verbs: `%` typed in a call's string argument opens the popup (GoFormatVerbProvider decides what it shows). -->
    <typedHandler implementation="io.github.golangsupport.ide.completion.GoFormatVerbTypedHandler" id="goFormatVerbTypedHandler"/>
    <!-- Struct tags: `:` after a known key writes `""` and opens the names, `,` in a value opens the options. -->
    <typedHandler implementation="io.github.golangsupport.ide.completion.GoStructTagTypedHandler" id="goStructTagTypedHandler"/>

  </extensions>
  <extensions defaultExtensionNs="io.github.golangsupport">
    <!-- The ranker without a model (frequency in the file and package, recency of choice); last, so that the ML ranker of a build with it wins. -->
    <completionRanker id="goHeuristicRanker" order="last" implementation="io.github.golangsupport.ide.completion.GoHeuristicRanker"/>
  </extensions>
  <projectListeners>
    <listener class="io.github.golangsupport.ide.completion.GoCompletionRecencyListener" topic="com.intellij.codeInsight.lookup.LookupManagerListener"/>
  </projectListeners>
  <extensionPoints>
    <!-- Optional re-ranking of completion candidates (docs/ML.md section 2); no implementation in go-psi. -->
    <extensionPoint qualifiedName="io.github.golangsupport.completionRanker"
                    interface="io.github.golangsupport.ide.completion.api.GoCompletionRanker" dynamic="true"/>
  </extensionPoints>
</idea-plugin>
