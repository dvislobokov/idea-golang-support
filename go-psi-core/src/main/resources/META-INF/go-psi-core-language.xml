<!-- The language registrations of go-psi-core: parser and AST factory (the file type is registered by the host plugin, and by the test
     descriptors of these modules). Kept apart from go-psi-core.xml so the host could include the indices before the parser (MIGRATION.md, steps 3-4). -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <lang.parserDefinition language="Go"
                           implementationClass="io.github.golangsupport.lang.parser.GoParserDefinition"/>
    <!-- Comments as GoCommentImpl: a PsiComment without the injection-host overhead (docs/FORMATTER.md). -->
    <lang.ast.factory language="Go" implementationClass="io.github.golangsupport.lang.psi.impl.GoASTFactory"/>
  </extensions>
</idea-plugin>
